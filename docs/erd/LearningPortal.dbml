// =====================================================================
// Learning Portal - So do thuc the lien ket (ERD)
// Nhom 1 - Nguyen The Sang, Nguyen Thanh Sang, Thai Thanh Vu
//
// Sinh tu 19 luoc do Mongoose that trong backend/src/models.
// MongoDB khong co khoa ngoai o tang CSDL; cac duong noi duoi day la
// quan he tham chieu bang ObjectId do tang ung dung rang buoc.
// Bang co chu "nhung trong ..." la mang tai lieu con nam ngay trong
// tai lieu cha, khong phai mot collection rieng.
// =====================================================================

Table User {
  _id ObjectId [pk]
  userId String [unique, note: 'USR + 8 so, tu sinh']
  name String [not null]
  fullname String
  birthday Date
  email String [unique, not null]
  password String [note: 'bam bcrypt, rong neu dang nhap Google']
  avatar String
  avatarPublicId String [note: 'public_id Cloudinary, chi khi tu tai len']
  passwordChangedAt Date [note: 'thu hoi JWT cap truoc luc doi mat khau']
  role String [not null, note: 'student | instructor | admin']
  provider ObjectId [ref: >? Provider._id, note: 'don vi dao tao']
  bio String
  phone String [unique]
  status Boolean [note: 'true = dang hoat dong']
  googleId String [unique]
  emailVerified Boolean [note: 'co y khong dat mac dinh']
  verifyTokenHash String [note: 'chi luu ban bam SHA-256']
  verifyTokenExp Date
  soDuCoin Number [not null, note: 'min 0, chi doi qua viCoin.js']
  createdAt Date
  updatedAt Date

  Note: 'Tai khoan va phan quyen ba vai tro.'
}

Table Provider {
  _id ObjectId [pk]
  name String [not null]
  slug String [unique, not null]
  logo String
  type String [note: 'company | university']

  Note: 'Don vi dao tao: truong hoc hoac doanh nghiep.'
}

Table Category {
  _id ObjectId [pk]
  name String [unique, not null]
  slug String [unique, not null]
  icon String

  Note: 'Danh muc khoa hoc.'
}

Table Course {
  _id ObjectId [pk]
  title String [not null]
  slug String [unique, not null]
  description String [not null]
  thumbnail String
  price Number [not null, note: '0 = mien phi']
  provider ObjectId [ref: >? Provider._id]
  level String [note: 'beginner | intermediate | advanced']
  instructor ObjectId [ref: > User._id, not null]
  totalDuration Number
  rating Number
  reviewsCount Number
  studentsCount Number
  isPublished Boolean [note: 'chi admin duoc xuat ban']
  isPopular Boolean
  isTrending Boolean
  isNewRelease Boolean
  createdAt Date
  updatedAt Date

  Note: 'Khoa hoc. Truong category la MANG ObjectId -> quan he nhieu nhieu voi Category.'
}

Table Course_Category {
  course ObjectId [ref: > Course._id, not null]
  category ObjectId [ref: > Category._id, not null]

  Note: 'Khong phai collection that. La mang Course.category, tach ra de ve cho ro quan he nhieu - nhieu.'
}

Table Lesson {
  _id ObjectId [pk]
  courseId ObjectId [ref: > Course._id, not null]
  title String [not null]
  slug String [not null]
  content String [note: 'noi dung chu, tro ly AI doc truong nay']
  videoUrl String [note: 'chi tra ve khi qua duocXemNoiDung()']
  documentUrl String
  duration String
  order Number
  createdAt Date
  updatedAt Date

  Note: 'Bai hoc. Chi muc ghep (courseId, slug).'
}

Table Enrollment {
  _id ObjectId [pk]
  course ObjectId [ref: > Course._id, not null]
  student ObjectId [ref: > User._id, not null]
  totalProgress Number [note: 'phan tram 0-100']
  status String [note: 'active | completed | dropped']
  completedAt Date
  lastAccessedAt Date
  finalScore Number
  createdAt Date
  updatedAt Date

  Note: 'Ghi danh. Chi muc duy nhat (course, student): mot hoc vien chi ghi danh mot lan.'
}

Table Enrollment_lessonProgress {
  enrollment ObjectId [ref: > Enrollment._id, not null]
  lesson ObjectId [ref: > Lesson._id, not null]
  status String [note: 'not_started | in_progress | completed']
  watchedDuration Number [note: 'giay']
  completedAt Date

  Note: 'Nhung trong Enrollment.lessonProgress. Tien do tung bai hoc.'
}

Table Quiz {
  _id ObjectId [pk]
  course ObjectId [ref: > Course._id, not null]
  lesson ObjectId [ref: >? Lesson._id, note: 'co the de trong']
  title String [not null]
  description String
  passingScore Number [note: 'phan tram, mac dinh 70']
  timeLimit Number [note: 'phut, null = khong gioi han']
  attempts Number [note: 'so lan lam duoc phep']
  randomizeQuestions Boolean
  randomizeOptions Boolean
  showAnswers Boolean
  totalPoints Number [note: 'tu cong lai truoc khi luu']
  isPublished Boolean
  createdAt Date
  updatedAt Date

  Note: 'De kiem tra trac nghiem.'
}

Table Quiz_questions {
  _id ObjectId [pk]
  quiz ObjectId [ref: > Quiz._id, not null]
  text String [not null]
  type String [note: 'multiple_choice | true_false | short_answer | essay']
  options Array [note: '{ text, isCorrect } - isCorrect KHONG bao gio gui ve trinh duyet truoc khi nop']
  correctAnswer String
  explanation String
  points Number

  Note: 'Nhung trong Quiz.questions. Ngan hang cau hoi cua de.'
}

Table QuizAttempt {
  _id ObjectId [pk]
  quiz ObjectId [ref: > Quiz._id, not null]
  student ObjectId [ref: > User._id, not null]
  score Number [not null]
  percentage Number [not null]
  passed Boolean [not null]
  timeSpent Number [note: 'giay']
  startedAt Date
  submittedAt Date [not null]
  attemptNumber Number
  retryReason String
  feedback String
  status String [note: 'submitted | graded | reviewed | reset']
  createdAt Date
  updatedAt Date

  Note: 'Luot lam bai. Chi muc duy nhat (quiz, student, attemptNumber).'
}

Table QuizAttempt_answers {
  attempt ObjectId [ref: > QuizAttempt._id, not null]
  questionId ObjectId [ref: > Quiz_questions._id, not null]
  studentAnswer Mixed
  isCorrect Boolean
  pointsEarned Number

  Note: 'Nhung trong QuizAttempt.answers. Cham tu dong o may chu.'
}

Table Certificate {
  _id ObjectId [pk]
  course ObjectId [ref: > Course._id, not null]
  student ObjectId [ref: > User._id, not null]
  certificateNumber String [unique, not null]
  title String [not null]
  description String
  completionDate Date [not null]
  courseName String
  instructorName String
  courseDuration String
  finalScore Number
  scorePercentage Number
  isPublic Boolean
  verificationUrl String
  verificationCode String [unique, note: 'ma tra cuu cong khai, khong can dang nhap']
  issuedAt Date
  expiresAt Date [note: 'null = khong het han']
  isValid Boolean
  signedBy String
  createdAt Date
  updatedAt Date

  Note: 'Chung nhan. Chi muc duy nhat (course, student).'
}

Table Review {
  _id ObjectId [pk]
  course ObjectId [ref: > Course._id, not null]
  student ObjectId [ref: > User._id, not null]
  rating Number [not null, note: '1 den 5']
  comment String [not null, note: '10 den 2000 ky tu']
  helpful Number
  unhelpful Number
  isVerifiedPurchase Boolean
  createdAt Date
  updatedAt Date

  Note: 'Danh gia khoa hoc. Chi muc duy nhat (course, student).'
}

Table Order {
  _id ObjectId [pk]
  code String [unique, not null, note: 'DH + 4 ky tu, dung lam noi dung chuyen khoan']
  course ObjectId [ref: > Course._id, not null]
  student ObjectId [ref: > User._id, not null]
  amount Number [not null]
  status String [note: 'pending | paid | cancelled | expired']
  expiresAt Date [not null, note: 'giu don 15 phut']
  paidAt Date
  confirmedBy ObjectId [ref: >? User._id, note: 'quan tri vien duyet don']
  note String
  daBaoChuyenKhoanLuc Date
  createdAt Date
  updatedAt Date

  Note: 'Don thanh toan chuyen khoan kem ma VietQR. Chi muc duy nhat (student, course) khi status = pending.'
}

Table GiaoDichCoin {
  _id ObjectId [pk]
  hocVien ObjectId [ref: > User._id, not null]
  loai String [not null, note: 'nap | thuHoi | mua | tangKhoa']
  soCoin Number [not null]
  soDuSau Number [not null, note: 'min 0, de doi soat lai so cai']
  khoa ObjectId [ref: >? Course._id]
  ghiChu String
  nguoiTao ObjectId [ref: >? User._id, note: 'quan tri vien thuc hien']
  createdAt Date
  updatedAt Date

  Note: 'So cai vi coin. Moi lan doi so du deu ghi mot dong o day.'
}

Table Achievement {
  _id ObjectId [pk]
  student ObjectId [ref: > User._id, not null]
  type String [not null, note: '11 loai: first_course_completed, perfect_score, learning_streak...']
  title String [not null]
  description String [not null]
  badgeImage String
  relatedCourse ObjectId [ref: >? Course._id]
  relatedQuiz ObjectId [ref: >? Quiz._id]
  level String [note: 'bronze | silver | gold | platinum']
  points Number
  isPublic Boolean
  unlockedAt Date
  createdAt Date
  updatedAt Date

  Note: 'Huy hieu thanh tich cua hoc vien.'
}

Table CuocTroChuyen {
  _id ObjectId [pk]
  user ObjectId [ref: > User._id, not null]
  course ObjectId [ref: > Course._id, not null]
  lesson ObjectId [ref: >? Lesson._id]
  createdAt Date
  updatedAt Date

  Note: 'Doan tro chuyen voi tro ly AI. Chi muc duy nhat (user, course, lesson).'
}

Table CuocTroChuyen_tinNhan {
  cuocTroChuyen ObjectId [ref: > CuocTroChuyen._id, not null]
  vaiTro String [not null, note: 'nguoiDung | troLy']
  noiDung String [not null, note: 'toi da 8000 ky tu']
  createdAt Date

  Note: 'Nhung trong CuocTroChuyen.tinNhan. Chi giu lai vai tin gan nhat lam ngu canh.'
}

Table BoDemGioiHan {
  _id String [pk, note: 'khoa dem, vi du troly:ip:1.2.3.4:gio']
  count Number
  firstAt Date [not null]
  blockedUntil Date
  expiresAt Date [not null, note: 'chi muc TTL - MongoDB tu xoa khi het han']

  Note: 'Bo dem gioi han tan suat: dang nhap sai, hoi tro ly AI. Khong noi voi bang nao - khoa la mot chuoi tu ghep.'
}

Table Post {
  _id ObjectId [pk]
  title String [not null]
  slug String [unique, not null]
  excerpt String [not null]
  content String [not null]
  thumbnail String
  topic String [note: '6 chu de: front-end, back-end, ai-llm, tester, ui-ux, others']
  tags Array
  author ObjectId [ref: > User._id, not null]
  views Number
  isPublished Boolean
  createdAt Date
  updatedAt Date

  Note: 'Bai viet blog. Co chi muc toan van tren title va excerpt.'
}

Table Document {
  _id ObjectId [pk]
  title String [not null]
  description String [not null]
  fileUrl String [not null]
  filePublicId String [note: 'public_id tren Cloudinary']
  fileName String [not null]
  fileExt String [not null, note: 'pdf | doc | docx']
  fileSize Number [not null]
  uploader ObjectId [ref: > User._id, not null]
  downloadCount Number
  createdAt Date
  updatedAt Date

  Note: 'Tai lieu hoc tap nguoi dung chia se.'
}

Table Faq {
  _id ObjectId [pk]
  courseId ObjectId [ref: >? Course._id, note: 'de trong = cau hoi cua trang chu']
  question String [not null]
  answer String [not null]
  createdAt Date
  updatedAt Date

  Note: 'Cau hoi thuong gap.'
}

Table Banner {
  _id ObjectId [pk]
  title String [not null]
  description String [not null]
  buttonText String
  linkUrl String
  backgroundColor String
  textColor String
  imageUrl String
  cloudinaryId String
  displayType String [note: 'DISCOUNT | IMAGE | DEFAULT']
  discountText String
  discountSubtext String
  order Number
  isActive Boolean
  page String [not null, note: 'HOME | COURSE_LIST | PRODUCT_LIST | CART']
  createdAt Date
  updatedAt Date

  Note: 'Banner quang cao theo trang.'
}

TableGroup "Tai khoan va to chuc" {
  User
  Provider
  Category
}

TableGroup "Noi dung khoa hoc" {
  Course
  Course_Category
  Lesson
  Faq
}

TableGroup "Hoc tap va danh gia" {
  Enrollment
  Enrollment_lessonProgress
  Quiz
  Quiz_questions
  QuizAttempt
  QuizAttempt_answers
  Certificate
  Review
  Achievement
}

TableGroup "Thanh toan" {
  Order
  GiaoDichCoin
}

TableGroup "Tro ly AI" {
  CuocTroChuyen
  CuocTroChuyen_tinNhan
  BoDemGioiHan
}

TableGroup "Noi dung phu" {
  Post
  Document
  Banner
}
