{
  "info": {
    "name": "Learning Portal - Enrollments API",
    "description": "Collection for testing Enrollments & Progress Tracking API",
    "version": "1.0"
  },
  "item": [
    {
      "name": "Enrollment Management",
      "item": [
        {
          "name": "Get My Courses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/my-courses",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "my-courses"]
            }
          }
        },
        {
          "name": "Get Enrollment Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}"]
            }
          }
        },
        {
          "name": "Get Progress Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}/progress",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}", "progress"]
            }
          }
        },
        {
          "name": "Get Course Students (Instructor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}/students",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}", "students"]
            }
          }
        }
      ]
    },
    {
      "name": "Lesson Progress",
      "item": [
        {
          "name": "Start Lesson",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lessonId\": \"{{lessonId}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}/start-lesson",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}", "start-lesson"]
            }
          }
        },
        {
          "name": "Update Watch Time",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lessonId\": \"{{lessonId}}\",\n  \"watchedDuration\": 330\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}/update-watch-time",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}", "update-watch-time"]
            }
          }
        },
        {
          "name": "Complete Lesson",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"lessonId\": \"{{lessonId}}\",\n  \"watchedDuration\": 900\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}/complete-lesson",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}", "complete-lesson"]
            }
          }
        },
        {
          "name": "Complete Course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}/complete-course",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}", "complete-course"]
            }
          }
        },
        {
          "name": "Drop Course",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/enrollments/course/{{courseId}}/drop",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "enrollments", "course", "{{courseId}}", "drop"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "courseId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lessonId",
      "value": "",
      "type": "string"
    }
  ]
}
