{
  "info": {
    "name": "Learning Portal - Certificates & Achievements",
    "description": "Collection for testing Certificates & Achievements API",
    "version": "1.0"
  },
  "item": [
    {
      "name": "Certificates",
      "item": [
        {
          "name": "Create Certificate",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enrollmentId\": \"{{enrollmentId}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/certificates",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "certificates"]
            }
          }
        },
        {
          "name": "Get My Certificates",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/certificates/my-certificates",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "certificates", "my-certificates"]
            }
          }
        },
        {
          "name": "Get Certificate By ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/certificates/{{certificateId}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "certificates", "{{certificateId}}"]
            }
          }
        },
        {
          "name": "Verify Certificate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/certificates/verify/{{verificationCode}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "certificates", "verify", "{{verificationCode}}"]
            }
          }
        },
        {
          "name": "Update Certificate (Public/Private)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isPublic\": true\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/certificates/{{certificateId}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "certificates", "{{certificateId}}"]
            }
          }
        },
        {
          "name": "Get User Public Certificates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/certificates/user/{{userId}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "certificates", "user", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Achievements",
      "item": [
        {
          "name": "Get My Achievements",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/achievements/my-achievements",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "achievements", "my-achievements"]
            }
          }
        },
        {
          "name": "Get User Achievements",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/achievements/user/{{userId}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "achievements", "user", "{{userId}}"]
            }
          }
        },
        {
          "name": "Get Leaderboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/achievements/leaderboard?limit=10",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "achievements", "leaderboard"],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "enrollmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "certificateId",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationCode",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    }
  ]
}
