# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/learning_portal

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Environment
NODE_ENV=development

# Server Port
PORT=5000

# Cloudinary - noi chua anh khoa hoc, banner, logo va file tai lieu chia se.
#
# CACH NHANH: trang Settings > API Keys cua Cloudinary in san mot dong day du,
# copy nguyen dong do vao day la xong, khong can ba bien duoi:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Thieu ba bien nay thi may chu van chay binh thuong, chi rieng cac duong
# tai file len tra ve 503 kem thong bao noi ro bien nao con thieu.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth - chi dung cho nut "Dang nhap bang Google".
# Bo trong thi cac cach dang nhap con lai van hoat dong.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# CAC ORIGIN DUOC PHEP GOI API
# ---------------------------------------------------------------------------
# Dung chung cho CA CORS lan chan CSRF. Cach nhau bang dau phay, moi cai la
# GOC (co giao thuc, khong co duong dan):
#
#   FRONTEND_ORIGINS=https://du-an.vercel.app,https://learning-portal.com
#
# Luc dev (NODE_ENV khac "production") thi moi port cua localhost va 127.0.0.1
# deu duoc chap nhan san, khong can dat bien nay.
#
# CHAY THAT thi BAT BUOC phai dat. De trong la khong origin nao qua duoc, va
# giao dien se bao 403 o moi thao tac ghi.
#
# Ban nhap (preview) cua Vercel co ten mien khac nhau moi lan push. Muon dang
# nhap duoc tren ban nhap thi them dung ten mien do vao day. Dung tim cach
# khop rong "*.vercel.app" - ai cung deploy len do duoc.
#
# CON MOT VIEC NUA tu khi co xac minh email: dia chi DAU TIEN trong danh sach
# nay chinh la goc dung de ghep lien ket gui trong thu xac minh. Dat sai thu
# tu la thu van gui di nhung lien ket tro nham ten mien.
FRONTEND_ORIGINS=

# Goc cua giao dien, CHI can dat khi no khac cai dau tien o FRONTEND_ORIGINS
# (vi du API cho phep ca ten mien cu lan moi, nhung thu phai tro ve ten mien
# moi). De trong thi lay tu FRONTEND_ORIGINS.
#
# Ca hai deu trong thi lui ve http://localhost:3000 - dung khi chay dev, con
# tren ban that thi moi lien ket xac minh se tro toi localhost va KHONG AI
# kich hoat duoc tai khoan. May chu ghi mot dong loi vao log khi roi vao canh
# do (xem utils/diaChiGiaoDien.js).
FRONTEND_URL=

# ---------------------------------------------------------------------------
# HOM THU
# ---------------------------------------------------------------------------
# Dung cho HAI viec:
#   1. Bao quan tri khi co nguoi bao da chuyen khoan / khi don duoc xac nhan.
#   2. Gui thu XAC MINH cho nguoi vua dang ky.
#
# Viec (2) la mot lop bao mat, khong phai tien ich: thieu hai bien duoi thi
# registerUser quay ve hanh vi cu - tao tai khoan va dang nhap ngay - va duong
# dang ky lai tra loi duoc cau hoi "email nay da co tai khoan chua". Tren ban
# chay that, DAT DU hai bien nay. May chu ghi console.error moi lan phai dung
# nhanh du phong do.
#
# MAIL_APP_PASSWORD la "App password" 16 ky tu, KHONG phai mat khau Gmail.
# Gmail chan dang nhap bang mat khau thuong tu 2022: phai bat xac thuc hai
# buoc roi tao o https://myaccount.google.com/apppasswords
#
# Kiem nhanh:  npm run check:mail
MAIL_USER=
MAIL_APP_PASSWORD=

# Dia chi NHAN thong bao quan tri. Bo trong thi gui ve chinh MAIL_USER.
MAIL_ADMIN=

# ---------------------------------------------------------------------------
# NHAN TIEN (thanh toan khoa hoc co phi)
# ---------------------------------------------------------------------------
# Ma QR duoc SINH RA tu ba bien nay chu khong phai anh tai len, nen moi don co
# san so tien va noi dung trong ma - nguoi mua quet xong khong phai go tay.
#
# Ma ngan hang theo danh sach VietQR: MB, VCB, TCB, ACB, BIDV, VPB...
# Xem day du o https://api.vietqr.io/v2/banks
NGAN_HANG=

# Chi so tai khoan, khong dau cach, khong dau cham.
SO_TAI_KHOAN=

# Ten chu tai khoan, VIET HOA KHONG DAU dung nhu ngan hang dang ky.
TEN_TAI_KHOAN=

# De trong ca ba thi trang thanh toan van hien duoc don va ma chuyen khoan,
# chi khong co anh QR - giao dien bao ro thay vi hien mot o anh vo.
