# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/learning_portal

# JWT Secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Environment
NODE_ENV=development

# Server Port
PORT=5000

# Cloudinary - noi chua anh khoa hoc, banner, logo va file tai lieu chia se.
#
# CACH NHANH: trang Settings > API Keys cua Cloudinary in san mot dong day du,
# copy nguyen dong do vao day la xong, khong can ba bien duoi:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Thieu ba bien nay thi may chu van chay binh thuong, chi rieng cac duong
# tai file len tra ve 503 kem thong bao noi ro bien nao con thieu.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth - chi dung cho nut "Dang nhap bang Google".
# Bo trong thi cac cach dang nhap con lai van hoat dong.
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# CAC ORIGIN DUOC PHEP GOI API
# ---------------------------------------------------------------------------
# Dung chung cho CA CORS lan chan CSRF. Cach nhau bang dau phay, moi cai la
# GOC (co giao thuc, khong co duong dan):
#
#   FRONTEND_ORIGINS=https://du-an.vercel.app,https://learning-portal.com
#
# Luc dev (NODE_ENV khac "production") thi moi port cua localhost va 127.0.0.1
# deu duoc chap nhan san, khong can dat bien nay.
#
# CHAY THAT thi BAT BUOC phai dat. De trong la khong origin nao qua duoc, va
# giao dien se bao 403 o moi thao tac ghi.
#
# Ban nhap (preview) cua Vercel co ten mien khac nhau moi lan push. Muon dang
# nhap duoc tren ban nhap thi them dung ten mien do vao day. Dung tim cach
# khop rong "*.vercel.app" - ai cung deploy len do duoc.
#
# CON MOT VIEC NUA tu khi co xac minh email: dia chi DAU TIEN trong danh sach
# nay chinh la goc dung de ghep lien ket gui trong thu xac minh. Dat sai thu
# tu la thu van gui di nhung lien ket tro nham ten mien.
FRONTEND_ORIGINS=

# Goc cua giao dien, CHI can dat khi no khac cai dau tien o FRONTEND_ORIGINS
# (vi du API cho phep ca ten mien cu lan moi, nhung thu phai tro ve ten mien
# moi). De trong thi lay tu FRONTEND_ORIGINS.
#
# Ca hai deu trong thi lui ve http://localhost:3000 - dung khi chay dev, con
# tren ban that thi moi lien ket xac minh se tro toi localhost va KHONG AI
# kich hoat duoc tai khoan. May chu ghi mot dong loi vao log khi roi vao canh
# do (xem utils/diaChiGiaoDien.js).
FRONTEND_URL=

# ---------------------------------------------------------------------------
# HOM THU
# ---------------------------------------------------------------------------
# Dung cho HAI viec:
#   1. Bao quan tri khi co nguoi bao da chuyen khoan / khi don duoc xac nhan.
#   2. Gui thu XAC MINH cho nguoi vua dang ky.
#
# Viec (2) la mot lop bao mat, khong phai tien ich: thieu hai bien duoi thi
# registerUser quay ve hanh vi cu - tao tai khoan va dang nhap ngay - va duong
# dang ky lai tra loi duoc cau hoi "email nay da co tai khoan chua". Tren ban
# chay that, DAT DU hai bien nay. May chu ghi console.error moi lan phai dung
# nhanh du phong do.
#
# MAIL_APP_PASSWORD la "App password" 16 ky tu, KHONG phai mat khau Gmail.
# Gmail chan dang nhap bang mat khau thuong tu 2022: phai bat xac thuc hai
# buoc roi tao o https://myaccount.google.com/apppasswords
#
# Kiem nhanh:  npm run check:mail
MAIL_USER=
MAIL_APP_PASSWORD=

# Dia chi NHAN thong bao quan tri. Bo trong thi gui ve chinh MAIL_USER.
MAIL_ADMIN=

# ---------------------------------------------------------------------------
# NHAN TIEN (thanh toan khoa hoc co phi)
# ---------------------------------------------------------------------------
# Ma QR duoc SINH RA tu ba bien nay chu khong phai anh tai len, nen moi don co
# san so tien va noi dung trong ma - nguoi mua quet xong khong phai go tay.
#
# Ma ngan hang theo danh sach VietQR: MB, VCB, TCB, ACB, BIDV, VPB...
# Xem day du o https://api.vietqr.io/v2/banks
NGAN_HANG=

# Chi so tai khoan, khong dau cach, khong dau cham.
SO_TAI_KHOAN=

# Ten chu tai khoan, VIET HOA KHONG DAU dung nhu ngan hang dang ky.
TEN_TAI_KHOAN=

# De trong ca ba thi trang thanh toan van hien duoc don va ma chuyen khoan,
# chi khong co anh QR - giao dien bao ro thay vi hien mot o anh vo.

# --- Tro giang AI (tuy chon) -------------------------------------------------
# Khong dat AI_API_KEY thi chuc nang tu tat, moi duong khac van chay binh thuong.
#
# ChatGPT ban mien phi KHONG dung duoc o day: tai khoan mien phi tren
# chat.openai.com khong cap khoa API, no chi la giao dien web.
#
# Chon mot trong bon, tuy khoa dang co:
#   gemini  Google AI Studio  - co goi MIEN PHI that, lay khoa o aistudio.google.com
#   groq    console.groq.com  - cung co goi mien phi, tra loi rat nhanh
#   openai  platform.openai.com - tra phi theo luot dung
#   claude  console.anthropic.com - tra phi, chat luong cao nhat trong bon
AI_NHA_CUNG_CAP=gemini
AI_API_KEY=

# De trong thi dung mo hinh mac dinh cua tung hang (xem src/utils/nhaCungCapAi.js).
# LUU Y: ten mo hinh co han su dung. gemini-2.5-flash da bi Google ngung cap cho
# khoa moi tu 09/2026. Goi ListModels de xem ten nao con dung duoc.
AI_MO_HINH=

# Webhook bao co ngan hang - cong coin tu dong khi tien ve.
#
# Dat mot chuoi ngau nhien dai (32 ky tu tro len), roi dan DUNG chuoi do vao
# phan cau hinh webhook ben nha cung cap (SePay, Casso...). Ho se gui kem no
# trong header 'Authorization: Apikey <chuoi>' moi lan bao co.
#
# CHUA DAT BIEN NAY thi duong webhook tu choi MOI request va tra 503 - co y
# nhu vay. Cho qua khi chua cau hinh la mo cua cho bat ky ai gui mot bao co
# gia de tu cong coin cho minh.
#
# Sinh chuoi: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_NGAN_HANG_SECRET=

# Tran chung cho toan bo API - luoi an toan chong vong lap va quet.
#
# De TRONG la dung trong hau het truong hop: mac dinh 1200 luot/phut va
# 20000 luot/gio cho moi dia chi IP. Chi dat khi that su can chinh.
#
# NGUONG PHAI RONG. Ca mot truong hoc di ra Internet bang MOT dia chi IP (NAT):
# mot lop 40 sinh vien cung mo trang, moi lan tai goi ~10 duong API, la da vai
# tram luot mot phut tu nguoi dung THAT. Con vong lap hay bot thi chay hang
# chuc nghin - khoang cach rat xa, khong so bat nham.
#
# Ha xuong thap de "cho an toan hon" la cach nhanh nhat de khoa nham ca mot
# lop hoc ma khong ai hieu vi sao.
#
# Doc dau src/middlewares/tranChung.js de biet tran nay chan duoc gi va KHONG
# chan duoc gi - no khong thay the duoc Vercel Firewall.
TRAN_API_MOI_PHUT=
TRAN_API_MOI_GIO=

# Thuoc tinh SameSite cua cookie dang nhap. DE TRONG la dung.
#
# Mac dinh 'lax': cookie khong duoc gui kem nhung request do trang cua ke khac
# tao ra. Dung duoc vi giao dien goi API vong qua rewrites() cua Next, nen
# trinh duyet chi thay MOT mien - cookie la ben thu nhat.
#
# CHI dat 'none' khi TRINH DUYET phai goi THANG sang mien cua backend:
#   - dat NEXT_PUBLIC_GOI_THANG_BACKEND=1 o frontend, hoac
#   - mot ung dung di dong / ten mien khac goi thang vao API nay.
# Khong dat trong truong hop do thi dang nhap tren ban that se hong.
#
# Luu y: 'none' la be mat CSRF (chongCsrf dang che), va Safari chan san cookie
# ben thu ba - nen do chi la giai phap tam. Doc dau src/utils/cookieToken.js.
#
# Bien nay KHONG co tac dung luc chay dev.
COOKIE_SAMESITE=
