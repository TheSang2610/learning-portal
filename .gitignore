# Thu muc goc cua kho gop. Moi du an con VAN giu .gitignore rieng cua no -
# file nay chi bat nhung thu co the sinh ra ngay tai goc.
node_modules/
.next/
.vercel/
*.tsbuildinfo

# Bien moi truong: khong bao gio commit. Chi .env.example duoc len kho.
.env
.env.*
!.env.example

# Next sinh ra file nay canh next.config. Sau khi don frontend xuong
# thu muc con, ban o goc chi la rac do trinh soan thao con coi goc la du an Next.
next-env.d.ts

# Ke tu khi goc kho chuyen len D:\aLMS_Project, thu muc lam viec rieng cua chu
# du an nam NGAY TRONG kho. Truoc day chung o ngoai nen khong can luat nao.
#
# vc.txt va gg2.txt chua token Vercel va bi mat OAuth Google dang chu ro - lo
# commit mot lan la phai thu hoi toan bo. CV la giay to ca nhan, khong phai ma
# nguon. luu-tru chua ban sao git (bundle) nang hang MB, dua len la kho phinh
# gap doi ma khong them mot dong ma nao.
vc.txt
gg2.txt
CV-*.html
luu-tru/
.claude/
