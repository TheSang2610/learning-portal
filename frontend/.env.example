# Chep file nay thanh .env.local roi dien gia tri.
# .env.local nam trong .gitignore - dung commit no.

# ---------------------------------------------------------------------------
# BAT BUOC
# ---------------------------------------------------------------------------

# Dia chi backend. Dien kieu nao cung duoc, ca hai deu chay:
#   http://localhost:5000        hoac   http://localhost:5000/api
# services/diaChiApi.ts se bo duoi "/api" va dau "/" thua.
#
# CANH BAO: NEXT_PUBLIC_ nghia la gia tri duoc NHUNG THANG vao JavaScript gui
# xuong trinh duyet. Khong bao gio dat khoa bi mat voi tien to nay.
#
# Next chi doc bien nay luc BUILD, khong doc luc chay. Doi dia chi la phai build lai.
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# TUY CHON - chi can cho nut "Dang nhap bang Google"
# Bo trong thi /api/auth/google tra 500 kem thong bao ro rang, cac cach dang
# nhap con lai van hoat dong binh thuong.
# ---------------------------------------------------------------------------

# KHONG co tien to NEXT_PUBLIC_ nen chi may chu doc duoc - dung them vao.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dia chi goc cua chinh trang nay, dung de dung duong dan quay ve.
# Vi du: http://localhost:3000
GOOGLE_ORIGIN=

# Bo trong thi mac dinh la ${GOOGLE_ORIGIN}/auth/callback.
# Dien vao day neu Google Console dang khai mot duong khac.
GOOGLE_REDIRECT_URI=

# ---------------------------------------------------------------------------
# TUY CHON - it khi can
# ---------------------------------------------------------------------------

# Dat = 1 de trinh duyet goi THANG sang backend, khong di qua Next.
#
# Mac dinh (bo trong) la di qua Next: next.config.ts chuyen tiep /api/* sang
# backend, nen trinh duyet chi thay MOT mien va cookie dang nhap la cookie ben
# thu nhat. Goi thang thi cookie thanh ben thu ba - Safari chan san, Chrome
# dang bo dan, va dang nhap se hong ma khong bao gi.
#
# Chi dat = 1 khi chay giao dien ma khong co may chu Next dung truoc, hoac khi
# can tai file rat lon vuot han muc kich thuoc than request cua nen tang.
NEXT_PUBLIC_GOI_THANG_BACKEND=

# Dia chi backend danh RIENG cho ma chay tren may chu (route handler trong
# app/api/). Dat khi backend nam sau mot dia chi noi bo ma trinh duyet khong
# goi duoc. Bo trong thi dung NEXT_PUBLIC_API_URL o tren.
BACKEND_URL=

# Duong dan endpoint dang nhap Google ben backend.
# Bo trong thi mac dinh /api/users/google
BACKEND_GOOGLE_AUTH_PATH=

# NEXT_PUBLIC_BACKEND_URL: ten cu, chi con lam duong lui cho NEXT_PUBLIC_API_URL.
# Du an moi thi dung NEXT_PUBLIC_API_URL, dung dat ca hai.
